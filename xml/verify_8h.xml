      <memberdef kind="define" id="verify_8h_1a84522088516585474b106c6e2db054ab" prot="public" static="no">
        <name>VSYNC_VERIFICATION</name>
        <briefdescription>
<para>enables vsyncer verification. </para>
        </briefdescription>
        <detaileddescription>
<para>Define VSYNC_VERIFICATION to enable verification with vsyncer, GenMC and Dartagnan. This uses compiler builtins for the implementation of atomic operations. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="vsync/common/verify.h" line="34" column="13" bodyfile="vsync/common/verify.h" bodystart="34" bodyend="-1"/>
      </memberdef>
      <memberdef kind="define" id="verify_8h_1a034de42fa8ca0bf6bd041f182c8516a2" prot="public" static="no">
        <name>VSYNC_VERIFICATION_GENERIC</name>
        <briefdescription>
<para>enables use if basic __VERIFIER_ functions. </para>
        </briefdescription>
        <detaileddescription>
