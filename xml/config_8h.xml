      <memberdef kind="define" id="config_8h_1ab0cd870d681cc370331283df1db318ad" prot="public" static="no">
        <name>VATOMIC_BUILTINS</name>
        <briefdescription>
<para>uses <computeroutput>__atomic</computeroutput> compiler builtins to implement atomic operations. </para>
        </briefdescription>
        <detaileddescription>
<para>Unless VATOMIC_BUILTINS is defined, arm32 and aarch64 architectures employ custom assembly as atomics implementation. Other architectures, including x86_64, always employ compiler builtins. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
