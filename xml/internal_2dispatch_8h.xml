      </memberdef>
      <memberdef kind="define" id="internal_2dispatch_8h_1ab2623c2965ee66989d448821f965dc80" prot="public" static="no">
        <name>V_DISPATCH32</name>
        <param><defname>S</defname></param>
        <param><defname>F</defname></param>
        <param><defname>mo</defname></param>
        <param><defname>a</defname></param>
