    <briefdescription>
<para>Multi-writer multi-reader optimistic lock. </para>
    </briefdescription>
    <detaileddescription>
<para>In seqlock writers are only blocked by writers but not by readers. Readers optimistically read shared variables and subsequently check their consistency. If any of the shared variables has been updated while being read, the readers must retry.</para>
<para><linebreak/>
<linebreak/>
### Example:<linebreak/>
<linebreak/>
</para>
<para><programlisting filename="eg_seqlock.c"><codeline><highlight class="preprocessor">#include<sp/>&lt;<ref refid="seqlock_8h" kindref="compound" tooltip="Multi-writer multi-reader optimistic lock.">vsync/spinlock/seqlock.h</ref>&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&lt;pthread.h&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&lt;stdio.h&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#define<sp/>N<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>1000</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#define<sp/>EXPECTED_VAL<sp/>(N<sp/>/<sp/>2)</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="structseqlock__s" kindref="compound">seqlock_t</ref><sp/>g_lock<sp/>=<sp/><ref refid="seqlock_8h_1a5fa968f0acd085f49958cee6a0565561" kindref="member" tooltip="Initializer of seqlock_t.">SEQ_LOCK_INIT</ref>();</highlight></codeline>
<codeline><highlight class="normal">vuint32_t<sp/>g_x<sp/><sp/><sp/><sp/>=<sp/>0;</highlight></codeline>
<codeline><highlight class="normal">vuint32_t<sp/>g_y<sp/><sp/><sp/><sp/>=<sp/>0;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">void</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">writer(</highlight><highlight class="keywordtype">void</highlight><highlight class="normal">)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="seqlock_8h_1a12ab300ba08455397d2c2134673ff434" kindref="member" tooltip="Acquires the lock in write-mode.">seqlock_acquire</ref>(&amp;g_lock);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>g_x++;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>g_y++;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="seqlock_8h_1ae473abbfa5c9f4819dad9c552571b82f" kindref="member" tooltip="Releases the lock in write-mode.">seqlock_release</ref>(&amp;g_lock);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">void</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">reader(</highlight><highlight class="keywordtype">void</highlight><highlight class="normal">)</highlight></codeline>
