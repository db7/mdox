      <memberdef kind="define" id="abstract__lock_8h_1a0a578d0ff996fcd10b338fe93f5e9c2f" prot="public" static="no">
        <name>DEF_ABSTRACT_LOCK</name>
        <param><defname>name</defname></param>
        <param><defname>lock_type</defname></param>
        <param><defname>lock_init</defname></param>
