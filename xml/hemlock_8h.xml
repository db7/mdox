    <briefdescription>
<para>Hemlock by Dice and Kogan. </para>
    </briefdescription>
    <detaileddescription>
<para><linebreak/>
<linebreak/>
### Example:<linebreak/>
<linebreak/>
</para>
<para><programlisting filename="eg_hemlock.c"><codeline><highlight class="preprocessor">#include<sp/>&lt;<ref refid="hemlock_8h" kindref="compound" tooltip="Hemlock by Dice and Kogan.">vsync/spinlock/hemlock.h</ref>&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&lt;vsync/common/assert.h&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&lt;pthread.h&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#include<sp/>&lt;stdio.h&gt;</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#define<sp/>N<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>12</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#define<sp/>MAX_THREADS<sp/><sp/>N</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#define<sp/>EXPECTED_VAL<sp/>N</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="structhemlock__s" kindref="compound" tooltip="Hemlock data structure.">hemlock_t</ref><sp/>g_lock_a<sp/>=<sp/><ref refid="hemlock_8h_1af39594fa1038e58f0333aec86d1089e5" kindref="member" tooltip="Initializer of hemlock_t.">HEMLOCK_INIT</ref>();</highlight></codeline>
<codeline><highlight class="normal"><ref refid="structhemlock__s" kindref="compound" tooltip="Hemlock data structure.">hemlock_t</ref><sp/>g_lock_b<sp/>=<sp/><ref refid="hemlock_8h_1af39594fa1038e58f0333aec86d1089e5" kindref="member" tooltip="Initializer of hemlock_t.">HEMLOCK_INIT</ref>();</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="structhem__node__s" kindref="compound" tooltip="Node of a thread/core for all Hemlock instances.">hem_node_t</ref><sp/>g_nodes[N];</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal">vuint32_t<sp/>g_x<sp/>=<sp/>0;</highlight></codeline>
<codeline><highlight class="normal">vuint32_t<sp/>g_y<sp/>=<sp/>0;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">void</highlight><highlight class="normal"><sp/>*</highlight></codeline>
<codeline><highlight class="normal">run(</highlight><highlight class="keywordtype">void</highlight><highlight class="normal"><sp/>*args)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>vsize_t<sp/>tid<sp/>=<sp/>(vsize_t)args;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>the<sp/>same<sp/>thread<sp/>context<sp/>object<sp/>can<sp/>be<sp/>used<sp/>with<sp/>multiple<sp/>instances<sp/>of</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>hemlock</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="hemlock_8h_1adb6fae8c527f2016bf68b0832f3a1839" kindref="member" tooltip="Acquires the Hemlock.">hemlock_acquire</ref>(&amp;g_lock_a,<sp/>&amp;g_nodes[tid]);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="hemlock_8h_1adb6fae8c527f2016bf68b0832f3a1839" kindref="member" tooltip="Acquires the Hemlock.">hemlock_acquire</ref>(&amp;g_lock_b,<sp/>&amp;g_nodes[tid]);</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>g_x++;</highlight></codeline>
